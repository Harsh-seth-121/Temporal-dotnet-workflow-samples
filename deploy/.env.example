# Copy to .env before running docker compose. `make up` does this for you.
#
# The project name prefixes every container, network, and volume. Two reasons it
# is set explicitly rather than left to default:
#   1. The default is the compose file's directory name, which would be "deploy".
#   2. Volume names are project-scoped, so a name already used by another stack on
#      the same machine means this one silently adopts that stack's data.
# Keep this unique to this repo.
COMPOSE_PROJECT_NAME=temporal-dotnet-samples

# Image pins. Bump deliberately; never use :latest in a box meant to be reproducible.
TEMPORAL_VERSION=1.32.0
TEMPORAL_UI_VERSION=2.55.0
POSTGRES_VERSION=16
PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.1.4

# Postgres
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal

# Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sandbox
TEMPORAL_RETENTION=72h

# Shard count is fixed when the schema is first created and cannot be changed in
# place. To change it: `make reset` (drops the Postgres volume), edit this value,
# then `make up`. Raising it matters once you start load testing; at 4, throughput
# plateaus on shard count rather than on anything you are trying to measure.
NUM_HISTORY_SHARDS=4

# Host ports. Container ports stay canonical; these are picked to dodge what
# commonly already runs on a dev machine.
PORT_TEMPORAL_GRPC=7233
PORT_TEMPORAL_METRICS=8000
PORT_TEMPORAL_UI=8088
PORT_POSTGRES=55432
PORT_PROMETHEUS=9090
PORT_GRAFANA=3001
PORT_WORKER_METRICS=9464
# Adminer, the browser UI in front of Postgres.
PORT_ADMINER=8089
